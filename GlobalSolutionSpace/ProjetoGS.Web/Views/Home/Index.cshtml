@{
    ViewData["Title"] = "Início";
}

<div class="d-flex flex-column justify-content-center align-items-center text-center min-vh-100 pb-5">
    <div class="animate-fade-up">
        <div class="badge bg-primary text-white px-3 py-2 mb-4" style="font-size: 0.9rem; letter-spacing: 2px;">
            <i class="bi bi-stars me-2"></i> INOVAÇÃO ALÉM DA ÓRBITA
        </div>
        
        <h1 class="display-1 fw-bold mb-4" style="line-height: 1.1; letter-spacing: -2px;">
            A Nova <span class="text-gradient d-block">Economia Espacial</span>
        </h1>
        
        <p class="lead text-secondary mx-auto mb-5" style="max-width: 600px; font-size: 1.25rem;">
            Explore e gerencie o catálogo definitivo de tecnologias que transcenderam missões espaciais e agora moldam o futuro sustentável na Terra.
        </p>

        <div class="d-flex justify-content-center gap-3">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Home" asp-action="Dashboard" class="btn btn-primary btn-lg px-5 py-3 rounded-pill" style="font-size: 1.1rem;">
                    Acessar Plataforma <i class="bi bi-arrow-right ms-2"></i>
                </a>
            }
            else
            {
                <a asp-controller="Auth" asp-action="Login" class="btn btn-primary btn-lg px-5 py-3 rounded-pill" style="font-size: 1.1rem;">
                    Acessar Plataforma <i class="bi bi-arrow-right ms-2"></i>
                </a>
                <a asp-controller="Auth" asp-action="Register" class="btn btn-outline-primary btn-lg px-5 py-3 rounded-pill" style="font-size: 1.1rem;">
                    Criar Conta
                </a>
            }
        </div>
    </div>
</div>
