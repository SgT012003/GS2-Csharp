@{
    ViewData["Title"] = "Login Administrativo";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="glass-card">
            <div class="text-center mb-4">
                <i class="bi bi-rocket-takeoff text-primary" style="font-size: 3rem;"></i>
                <h3 class="mt-3 fw-bold">Login Admin</h3>
                <p class="text-secondary">Nova Economia Espacial</p>
            </div>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger" role="alert">
                    @ViewBag.ErrorMessage
                </div>
            }

            <form asp-action="Login" method="post">
                <div class="mb-3">
                    <label for="email" class="form-label">E-mail</label>
                    <input type="email" class="form-control" id="email" name="email" required placeholder="admin@novaeconomia.space">
                </div>
                <div class="mb-4">
                    <label for="password" class="form-label">Senha</label>
                    <input type="password" class="form-control" id="password" name="password" required placeholder="••••••••">
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg">Entrar</button>
                </div>
            </form>
            
            <div class="mt-4 text-center">
                <hr class="border-secondary">
                <p class="text-secondary small mb-1">Credenciais de Exemplo para Teste:</p>
                <p class="mb-0 small"><strong>E-mail:</strong> admin@novaeconomia.space</p>
                <p class="small"><strong>Senha:</strong> Admin@123</p>
            </div>
        </div>
    </div>
</div>
