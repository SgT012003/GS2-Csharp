@{
    ViewData["Title"] = "Login Administrativo";
}

<div class="row justify-content-center mt-5 animate-fade-up">
    <div class="col-md-5">
        <div class="glass-card" style="padding: 3rem 2rem;">
            <div class="text-center mb-5">
                <i class="bi bi-globe2 text-primary" style="font-size: 3rem;"></i>
                <h3 class="mt-3 fw-bold text-white">Bem-vindo de volta</h3>
                <p class="text-secondary">Acesse a plataforma <span class="text-gradient">Nova Economia Espacial</span></p>
            </div>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger shadow-sm border-0 animate-fade-up">@ViewBag.ErrorMessage</div>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success shadow-sm border-0 animate-fade-up">@TempData["SuccessMessage"]</div>
            }

            <form asp-action="Login" method="post">
                <div class="mb-4">
                    <label for="email" class="form-label">E-mail Corporativo</label>
                    <input type="email" class="form-control" id="email" name="email" required placeholder="exemplo@novaeconomia.space">
                </div>
                <div class="mb-4">
                    <label for="password" class="form-label">Senha</label>
                    <input type="password" class="form-control" id="password" name="password" required placeholder="••••••••">
                </div>
                <div class="d-grid mt-5">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill">Entrar no Sistema</button>
                </div>
                <div class="text-center mt-4">
                    <a asp-action="Register" class="text-secondary text-decoration-none small hover-text-primary">Ainda não tem conta? <span class="text-primary fw-bold">Cadastre-se</span></a>
                </div>
            </form>
            
            <div class="mt-5 text-center p-3 rounded" style="background: rgba(255,255,255,0.02); border: 1px dashed rgba(255,255,255,0.1);">
                <p class="text-secondary small mb-2"><i class="bi bi-info-circle me-1"></i> Credenciais de Administrador Padrão:</p>
                <p class="mb-0 small text-white"><strong>E-mail:</strong> admin@novaeconomia.space</p>
                <p class="small text-white"><strong>Senha:</strong> Admin@123</p>
            </div>
        </div>
    </div>
</div>
