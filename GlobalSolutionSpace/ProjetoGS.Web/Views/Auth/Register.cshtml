@model ProjetoGS.Web.Models.RegisterRequestDTO

@{
    ViewData["Title"] = "Criar Conta";
}

<div class="row justify-content-center mt-5 animate-fade-up">
    <div class="col-md-5">
        <div class="glass-card" style="padding: 3rem 2rem;">
            <div class="text-center mb-5">
                <i class="bi bi-person-plus text-primary" style="font-size: 3rem;"></i>
                <h3 class="mt-3 fw-bold text-white">Criar Nova Conta</h3>
                <p class="text-secondary">Junte-se à <span class="text-gradient">Nova Economia Espacial</span></p>
            </div>
            
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger shadow-sm border-0 animate-fade-up">@ViewBag.ErrorMessage</div>
            }

            <form asp-action="Register" method="post">
                <div class="mb-4">
                    <label asp-for="Nome" class="form-label">Nome Completo</label>
                    <input asp-for="Nome" class="form-control" required />
                </div>
                <div class="mb-4">
                    <label asp-for="Email" class="form-label">E-mail Corporativo</label>
                    <input asp-for="Email" type="email" class="form-control" required />
                </div>
                <div class="mb-5">
                    <label asp-for="Senha" class="form-label">Senha de Acesso</label>
                    <input asp-for="Senha" type="password" class="form-control" required />
                </div>
                <div class="d-grid gap-3">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill">Finalizar Cadastro</button>
                    <a asp-action="Login" class="btn btn-outline-secondary btn-lg rounded-pill">Já tenho conta</a>
                </div>
            </form>
        </div>
    </div>
</div>
