@model ProjetoGS.Web.Models.OrigemDTO

@{
    ViewData["Title"] = "Deletar Origem";
}

<div class="row justify-content-center mt-5 animate-fade-up">
    <div class="col-md-6">
        <div class="glass-card border-danger" style="border-color: rgba(244, 63, 94, 0.3) !important;">
            <h3 class="fw-bold mb-4 text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Confirmar Exclusão</h3>
            <p class="text-secondary fs-5 mb-4">Tem certeza que deseja excluir permanentemente a origem <strong>@Model.Nome</strong>?</p>
            
            <div class="p-3 mb-4 rounded" style="background: rgba(255,255,255,0.02);">
                <div class="mb-2"><span class="text-secondary me-2">ID:</span> <span class="text-white fw-bold">#@Model.Id</span></div>
                <div class="mb-2"><span class="text-secondary me-2">Descrição:</span> <span class="text-white">@Model.Descricao</span></div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">Excluir Permanentemente</button>
                </div>
            </form>
        </div>
    </div>
</div>
