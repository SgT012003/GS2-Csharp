@model ProjetoGS.Web.Models.TecnologiaDTO

@{
    ViewData["Title"] = "Excluir Tecnologia";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="glass-card border-danger">
            <div class="text-center mb-4">
                <i class="bi bi-exclamation-triangle text-danger" style="font-size: 3rem;"></i>
                <h3 class="mt-2">Confirmar Exclusão</h3>
                <p class="text-secondary">Tem certeza que deseja excluir esta tecnologia? Esta ação não pode ser desfeita.</p>
            </div>

            <div class="bg-dark p-3 rounded mb-4">
                <h5 class="text-white">@Model.Nome</h5>
                <p class="text-secondary mb-1"><strong>Origem:</strong> @(Model.Origem?.Nome ?? "Desconhecido")</p>
                <p class="text-secondary mb-0"><strong>Cadastrado em:</strong> @Model.DataCadastro.ToShortDateString()</p>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash3 me-1"></i> Excluir Definitivamente</button>
                </div>
            </form>
        </div>
    </div>
</div>
