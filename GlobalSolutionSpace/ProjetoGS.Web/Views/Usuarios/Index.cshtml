@model IEnumerable<ProjetoGS.Web.Models.UsuarioDTO>

@{
    ViewData["Title"] = "Gestão de Usuários";
}

<div class="row mb-4 mt-3">
    <div class="col">
        <h2 class="display-6 fw-bold text-primary"><i class="bi bi-people me-2"></i>Gestão de Usuários</h2>
        <p class="lead text-secondary">Apenas administradores podem promover ou rebaixar contas.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="row">
    <div class="col-12">
        <div class="glass-card p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="bg-dark text-uppercase">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Nome</th>
                            <th>E-mail</th>
                            <th>Perfil Atual</th>
                            <th class="pe-4 text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-white">#@user.Id</td>
                                <td>@user.Nome</td>
                                <td class="text-secondary">@user.Email</td>
                                <td>
                                    @if(user.Perfil == "Administrador")
                                    {
                                        <span class="badge bg-danger">@user.Perfil</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">@user.Perfil</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <form asp-action="UpdateRole" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        @if(user.Perfil == "Pesquisador")
                                        {
                                            <input type="hidden" name="perfil" value="Administrador" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-arrow-up-circle"></i> Promover Admin
                                            </button>
                                        }
                                        else
                                        {
                                            <input type="hidden" name="perfil" value="Pesquisador" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-arrow-down-circle"></i> Rebaixar
                                            </button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
