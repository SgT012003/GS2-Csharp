@model ProjetoGS.Web.Models.TecnologiaDTO

@{
    ViewData["Title"] = "Editar Tecnologia";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="glass-card">
            <h3 class="mb-4"><i class="bi bi-pencil-square text-warning me-2"></i>Editar Tecnologia</h3>
            
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="DataCadastro" />
                
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Nome" class="form-label">Nome da Tecnologia</label>
                        <input asp-for="Nome" class="form-control" required />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CategoriaImpactoId" class="form-label">Categoria de Impacto</label>
                        <select asp-for="CategoriaImpactoId" class="form-select" asp-items="ViewBag.Categorias" required></select>
                    </div>
                    <div class="col-12">
                        <label asp-for="Descricao" class="form-label">Descrição Resumida</label>
                        <textarea asp-for="Descricao" class="form-control" rows="3" required></textarea>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="OrigemEspacial" class="form-label">Origem (Missão/Contexto Espacial)</label>
                        <select asp-for="OrigemEspacial" class="form-select" asp-items="ViewBag.Origens" required></select>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top border-secondary d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-warning text-dark"><i class="bi bi-save me-1"></i> Atualizar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
